# Supabase 연결 값 — 둘 다 '공개용' 값입니다(브라우저에 들어감).
# 로컬 개발: 이 파일을 .env.local로 복사해 값을 채움(.env.local은 커밋되지 않음)
# 배포: GitHub 저장소 Settings → Secrets and variables → Actions → Variables 에
#       SUPABASE_URL, SUPABASE_ANON_KEY 이름으로 넣으면 빌드에 자동으로 들어감
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# service_role(또는 secret) 키는 절대 여기나 저장소 어디에도 넣지 않습니다.
